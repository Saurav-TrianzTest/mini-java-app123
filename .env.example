# Cloud-Ready Environment Variables Configuration
# Copy this file to .env and update with your values

# ===================================
# Server Configuration
# ===================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_CONTEXT_PATH=/mini-app

# ===================================
# Database Configuration
# ===================================
DATABASE_URL=jdbc:mysql://localhost:3306/mini_app_db
DATABASE_USERNAME=appuser
DATABASE_PASSWORD=changeme
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver
DATABASE_POOL_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=600000
DATABASE_MAX_LIFETIME=1800000
DATABASE_QUERY_TIMEOUT=30

# ===================================
# Redis Cache Configuration
# ===================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===================================
# External Services Configuration
# ===================================
EXTERNAL_API_BASE_URL=http://api.example.com:8080/v1
EXTERNAL_API_TIMEOUT=30000
EXTERNAL_API_KEY=your-api-key-here

PAYMENT_SERVICE_URL=https://payment.internal.company.com/process
PAYMENT_SERVICE_USERNAME=payment-user
PAYMENT_SERVICE_PASSWORD=payment-password

# ===================================
# AWS Configuration
# ===================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Storage Configuration
S3_BUCKET_NAME=your-bucket-name
APP_STORAGE_TYPE=s3

# ===================================
# File System Paths (Cloud-Native)
# ===================================
APP_CONFIG_DIRECTORY=/app/config
APP_LOG_DIRECTORY=/app/logs
APP_TEMP_DIRECTORY=/tmp/mini-app
APP_UPLOAD_DIRECTORY=/app/uploads

# ===================================
# Security Configuration
# ===================================
JWT_SECRET=your-jwt-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure-admin-password
ENCRYPTION_KEY=your-encryption-key

# ===================================
# Monitoring Configuration
# ===================================
MONITORING_ENDPOINT=http://monitoring.internal.company.com:9090/metrics
MONITORING_USERNAME=monitor-user
MONITORING_PASSWORD=monitor-password

# ===================================
# Messaging Configuration
# ===================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq-user
RABBITMQ_PASSWORD=rabbitmq-password

# ===================================
# Application Configuration
# ===================================
ENVIRONMENT=development
DEBUG_ENABLED=false
LOGGING_LEVEL=INFO

# ===================================
# Correlation ID for Distributed Tracing
# ===================================
CORRELATION_ID=
