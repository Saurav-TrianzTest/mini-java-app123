# Environment Variables Template for Cloud Deployment
# Copy this file to .env and set appropriate values for your environment
# For production: Use cloud secret management (AWS Secrets Manager, Azure Key Vault, GCP Secret Manager)

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_CONTEXT_PATH=/mini-app

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Database connection details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mini_app_db
DB_USERNAME=app_user
DB_PASSWORD=change_me_in_production
DB_USE_SSL=true

# HikariCP connection pool settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000
DB_QUERY_TIMEOUT=30

# ============================================================================
# CACHE CONFIGURATION (Redis/ElastiCache)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2000
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# External API configuration
EXTERNAL_API_URL=http://api.example.com/v1
EXTERNAL_API_KEY=your_api_key_here
EXTERNAL_API_TIMEOUT=30000
EXTERNAL_API_RETRY_MAX=3
EXTERNAL_API_RETRY_BACKOFF=1000

# Payment service configuration
PAYMENT_SERVICE_URL=https://payment.example.com/process
PAYMENT_SERVICE_USERNAME=payment_user
PAYMENT_SERVICE_PASSWORD=change_me_in_production
PAYMENT_SERVICE_TIMEOUT=30000

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# JWT configuration
JWT_SECRET=your_jwt_secret_key_min_256_bits
JWT_EXPIRATION=86400000
JWT_ISSUER=mini-app

# Admin credentials (use IAM in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# Encryption configuration
ENCRYPTION_KEY=your_encryption_key_here
ENCRYPTION_ALGORITHM=AES

# ============================================================================
# CLOUD STORAGE CONFIGURATION
# ============================================================================
# AWS S3 / Azure Blob / GCP Cloud Storage
UPLOAD_BUCKET=my-app-uploads
UPLOAD_REGION=us-east-1
TEMP_DIR=/tmp

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
MONITORING_ENDPOINT=http://monitoring.example.com/metrics
MONITORING_USERNAME=monitor_user
MONITORING_PASSWORD=change_me_in_production
MONITORING_INTERVAL=60000

# Logging configuration
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ============================================================================
# MESSAGING CONFIGURATION
# ============================================================================
# RabbitMQ configuration
MESSAGING_BROKER_TYPE=rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq_user
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_VHOST=/

# AWS SQS configuration (alternative)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/my-queue
SQS_REGION=us-east-1

# ============================================================================
# ENVIRONMENT & CLOUD PLATFORM
# ============================================================================
SPRING_PROFILES_ACTIVE=production
APP_ENVIRONMENT=production
DEBUG_ENABLED=false

# Cloud platform configuration
CLOUD_PLATFORM=aws
CLOUD_REGION=us-east-1
CLOUD_AZ=us-east-1a

# ============================================================================
# NOTES FOR CLOUD DEPLOYMENT
# ============================================================================
# AWS ECS/Fargate: Set these as environment variables in task definition
# AWS Elastic Beanstalk: Set in environment properties
# Kubernetes: Use ConfigMaps for non-sensitive data, Secrets for sensitive data
# Docker: Pass via -e flags or docker-compose environment section
# 
# For sensitive values (passwords, API keys, secrets):
# - AWS: Use AWS Secrets Manager or Systems Manager Parameter Store
# - Azure: Use Azure Key Vault
# - GCP: Use Google Secret Manager
# - Kubernetes: Use Kubernetes Secrets with encryption at rest
