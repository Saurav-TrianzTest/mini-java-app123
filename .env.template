# Environment Variables Template for Cloud Deployment
# Copy this file to .env and populate with actual values
# DO NOT commit .env file with actual credentials to version control

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_CONTEXT_PATH=/mini-app
ENVIRONMENT=production

# Database Configuration (AWS RDS)
DB_HOST=your-rds-instance.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=mini_app_db
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000
DB_QUERY_TIMEOUT=30

# Cache Configuration (AWS ElastiCache)
REDIS_HOST=your-elasticache.region.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DATABASE=0

# External Service URLs
EXTERNAL_API_URL=https://api.example.com/v1
EXTERNAL_API_TIMEOUT=30000
EXTERNAL_API_KEY=your-api-key

# Payment Service Configuration
PAYMENT_SERVICE_URL=https://payment.internal.company.com/process
PAYMENT_SERVICE_USERNAME=your-payment-username
PAYMENT_SERVICE_PASSWORD=your-payment-password

# Security Configuration (Use AWS Secrets Manager in production)
JWT_SECRET=your-jwt-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ENCRYPTION_KEY=your-encryption-key

# Monitoring Configuration
MONITORING_ENDPOINT=https://monitoring.internal.company.com/metrics
MONITORING_USERNAME=your-monitoring-username
MONITORING_PASSWORD=your-monitoring-password

# Messaging Configuration (AWS MQ or RabbitMQ)
RABBITMQ_HOST=your-rabbitmq.region.mq.amazonaws.com
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your-rabbitmq-username
RABBITMQ_PASSWORD=your-rabbitmq-password

# Logging Configuration
LOGGING_LEVEL=INFO
DEBUG_ENABLED=false

# AWS-Specific Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_RDS_ENDPOINT=your-rds-endpoint
AWS_ELASTICACHE_ENDPOINT=your-elasticache-endpoint

# Application Directories (can use cloud storage instead)
APP_CONFIG_DIR=/config
APP_LOG_DIR=/logs
APP_TEMP_DIR=/tmp
APP_UPLOAD_DIR=/uploads
