# Environment Variables Template for Cloud Deployment
# Copy this file to .env and fill in the values
# DO NOT commit .env file to source control

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Store these in AWS Secrets Manager
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=3306
DB_NAME=mini_app_db
DB_USERNAME=app_user
DB_PASSWORD=<retrieve-from-aws-secrets-manager>
DB_QUERY_TIMEOUT=30

# ============================================
# REDIS CACHE CONFIGURATION
# ============================================
REDIS_HOST=your-elasticache-endpoint.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<retrieve-from-aws-secrets-manager>
REDIS_DATABASE=0

# ============================================
# EXTERNAL API CONFIGURATION
# ============================================
EXTERNAL_API_URL=https://api.example.com/v1
EXTERNAL_API_KEY=<retrieve-from-aws-secrets-manager>
EXTERNAL_API_TIMEOUT=30000

# ============================================
# PAYMENT SERVICE CONFIGURATION
# ============================================
PAYMENT_SERVICE_URL=https://payment.example.com/process
PAYMENT_SERVICE_USERNAME=<retrieve-from-aws-secrets-manager>
PAYMENT_SERVICE_PASSWORD=<retrieve-from-aws-secrets-manager>
PAYMENT_SERVICE_TOKEN=<retrieve-from-aws-secrets-manager>

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Store these in AWS Secrets Manager
JWT_SECRET=<retrieve-from-aws-secrets-manager>
ENCRYPTION_KEY=<retrieve-from-aws-secrets-manager>
ADMIN_USERNAME=<retrieve-from-aws-secrets-manager>
ADMIN_PASSWORD=<retrieve-from-aws-secrets-manager>

# ============================================
# SERVER CONFIGURATION
# ============================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_CONTEXT_PATH=/mini-app

# ============================================
# MONITORING CONFIGURATION
# ============================================
MONITORING_ENDPOINT=http://monitoring.example.com:9090/metrics
MONITORING_USERNAME=<retrieve-from-aws-secrets-manager>
MONITORING_PASSWORD=<retrieve-from-aws-secrets-manager>

# ============================================
# MESSAGING CONFIGURATION
# ============================================
RABBITMQ_HOST=your-rabbitmq-endpoint.amazonaws.com
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<retrieve-from-aws-secrets-manager>
RABBITMQ_PASSWORD=<retrieve-from-aws-secrets-manager>

# ============================================
# AWS CONFIGURATION
# ============================================
AWS_REGION=us-east-1
AWS_SECRETS_ENABLED=true
AWS_PARAMETER_STORE_ENABLED=true

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_NAME=mini-java-app
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG_ENABLED=false
LOG_LEVEL=INFO
INSTANCE_ID=<auto-generated-by-aws>

# ============================================
# FILE PATHS (Use S3 or EFS in production)
# ============================================
APP_CONFIG_DIR=/config
APP_LOG_DIR=/logs
APP_TEMP_DIR=/tmp
APP_UPLOAD_DIR=/uploads

# ============================================
# DATABASE CONNECTION POOL
# ============================================
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_TIMEOUT=5000
