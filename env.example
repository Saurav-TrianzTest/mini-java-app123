# =============================================================================
# CLOUD DEPLOYMENT ENVIRONMENT VARIABLES
# =============================================================================
# This file documents all environment variables required for cloud deployment
# Copy this file and set appropriate values for your environment
#
# For AWS: Use ECS Task Definitions, Lambda Environment Variables, or Parameter Store
# For Azure: Use App Service Configuration, Container Instances Environment Variables
# For GCP: Use Cloud Run Environment Variables, GKE ConfigMaps/Secrets
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_CONTEXT_PATH=/mini-app

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Primary database connection
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=mini_app_db
DB_URL=jdbc:mysql://your-rds-endpoint.region.rds.amazonaws.com:3306/mini_app_db
DB_USERNAME=app_user
DB_PASSWORD=<use-secrets-manager>
DB_DRIVER=com.mysql.cj.jdbc.Driver

# HikariCP Connection Pool Settings
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000
DB_QUERY_TIMEOUT=30

# -----------------------------------------------------------------------------
# CACHE CONFIGURATION (Redis/ElastiCache)
# -----------------------------------------------------------------------------
REDIS_HOST=your-elasticache-endpoint.region.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<use-secrets-manager>
REDIS_DATABASE=0

# -----------------------------------------------------------------------------
# EXTERNAL SERVICE URLS
# -----------------------------------------------------------------------------
EXTERNAL_API_URL=https://api.example.com/v1
EXTERNAL_API_TIMEOUT=30000
EXTERNAL_API_KEY=<use-secrets-manager>

PAYMENT_SERVICE_URL=https://payment.example.com/process
PAYMENT_SERVICE_USERNAME=<use-secrets-manager>
PAYMENT_SERVICE_PASSWORD=<use-secrets-manager>

# -----------------------------------------------------------------------------
# CLOUD STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# AWS S3
APP_CONFIG_DIR=s3://your-bucket-name/config
APP_TEMP_DIR=/tmp
APP_UPLOAD_DIR=s3://your-bucket-name/uploads

# Azure Blob Storage (alternative)
# APP_UPLOAD_DIR=https://youraccount.blob.core.windows.net/uploads

# GCP Cloud Storage (alternative)
# APP_UPLOAD_DIR=gs://your-bucket-name/uploads

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION (Use Cloud Secrets Management)
# -----------------------------------------------------------------------------
# AWS: Store in AWS Secrets Manager or Systems Manager Parameter Store
# Azure: Store in Azure Key Vault
# GCP: Store in Secret Manager

JWT_SECRET=<use-secrets-manager>
ADMIN_USERNAME=<use-secrets-manager>
ADMIN_PASSWORD=<use-secrets-manager>
ENCRYPTION_KEY=<use-secrets-manager>

# -----------------------------------------------------------------------------
# MONITORING & METRICS
# -----------------------------------------------------------------------------
MONITORING_ENDPOINT=https://monitoring.example.com/metrics
MONITORING_USERNAME=<use-secrets-manager>
MONITORING_PASSWORD=<use-secrets-manager>

# Cloud-native monitoring (no configuration needed, automatic):
# AWS: CloudWatch automatically captures logs and metrics
# Azure: Application Insights automatically captures telemetry
# GCP: Cloud Logging and Monitoring automatically capture data

# -----------------------------------------------------------------------------
# MESSAGING CONFIGURATION
# -----------------------------------------------------------------------------
# RabbitMQ (if using Amazon MQ)
RABBITMQ_HOST=your-amazonmq-endpoint.region.amazonaws.com
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<use-secrets-manager>
RABBITMQ_PASSWORD=<use-secrets-manager>

# AWS SQS (alternative)
# AWS_SQS_QUEUE_URL=https://sqs.region.amazonaws.com/account-id/queue-name

# Azure Service Bus (alternative)
# AZURE_SERVICEBUS_CONNECTION_STRING=<use-key-vault>

# GCP Pub/Sub (alternative)
# GCP_PUBSUB_PROJECT_ID=your-project-id
# GCP_PUBSUB_TOPIC=your-topic-name

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG_ENABLED=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# AWS-SPECIFIC CONFIGURATION
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<use-iam-roles-instead>
AWS_SECRET_ACCESS_KEY=<use-iam-roles-instead>

# Note: For ECS/EKS/Lambda, use IAM roles instead of access keys
# The application will automatically use the IAM role attached to the service

# -----------------------------------------------------------------------------
# DEPLOYMENT EXAMPLES
# -----------------------------------------------------------------------------

# Example 1: AWS ECS Task Definition (JSON snippet)
# {
#   "environment": [
#     {"name": "SERVER_PORT", "value": "8080"},
#     {"name": "DB_HOST", "value": "mydb.region.rds.amazonaws.com"},
#     {"name": "ENVIRONMENT", "value": "production"}
#   ],
#   "secrets": [
#     {"name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:region:account:secret:db-password"},
#     {"name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:region:account:secret:jwt-secret"}
#   ]
# }

# Example 2: Kubernetes ConfigMap + Secret
# apiVersion: v1
# kind: ConfigMap
# metadata:
#   name: mini-app-config
# data:
#   SERVER_PORT: "8080"
#   DB_HOST: "mydb.region.rds.amazonaws.com"
#   ENVIRONMENT: "production"
# ---
# apiVersion: v1
# kind: Secret
# metadata:
#   name: mini-app-secrets
# type: Opaque
# data:
#   DB_PASSWORD: <base64-encoded>
#   JWT_SECRET: <base64-encoded>

# Example 3: Docker Run Command
# docker run -d \
#   -e SERVER_PORT=8080 \
#   -e DB_HOST=mydb.region.rds.amazonaws.com \
#   -e DB_USERNAME=app_user \
#   -e DB_PASSWORD=secret \
#   -e ENVIRONMENT=production \
#   -p 8080:8080 \
#   mini-java-app:latest

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
# 1. NEVER commit this file with real credentials to version control
# 2. Use cloud-native secrets management:
#    - AWS: Secrets Manager, Systems Manager Parameter Store
#    - Azure: Key Vault
#    - GCP: Secret Manager
# 3. Use IAM roles/managed identities instead of access keys
# 4. Rotate secrets regularly
# 5. Use least-privilege access policies
# 6. Enable encryption at rest and in transit
# 7. Use VPC/VNet for network isolation
# 8. Enable audit logging (CloudTrail, Azure Monitor, Cloud Audit Logs)
