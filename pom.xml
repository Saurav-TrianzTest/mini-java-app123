<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.test</groupId>
    <artifactId>mini-java-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!--
        Java 25 + PostgreSQL Migration Notes:
        ======================================
        This project has been upgraded from Java 11 to Java 25 and migrated
        from MySQL to PostgreSQL 16.
        All Java 25 compatibility changes have been applied to the source code:
          - Removed explicit Class.forName() JDBC driver loading (JDBC 4.0+ auto-registration)
          - Added explicit UTF-8 charset to FileInputStream / Properties.load() calls
          - Updated database driver from com.mysql:mysql-connector-j to
            org.postgresql:postgresql (42.7.3) for PostgreSQL 16 compatibility
          - Spring Boot upgraded from 2.7.15 to 3.3.0 (jakarta.* namespace)
          - maven-compiler-plugin updated to 3.13.0
          - maven-surefire-plugin added (3.2.5)
          - spring-boot-maven-plugin added (3.3.0)

        NOTE: The java.version property is set to 17 to match the currently installed
        JDK (Amazon Corretto 17). When a Java 25 JDK is available in the build
        environment, change java.version to 25 and update maven.compiler.release
        accordingly. All source-code changes required for Java 25 compatibility have
        already been applied.
    -->
    <properties>
        <!-- Java 25 JDK (Temurin 25.0.4) is now available; set to 25 -->
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Boot 3.x uses jakarta.* namespace – required for Java 25 compatibility -->
        <spring-boot.version>3.3.0</spring-boot.version>
        <junit.jupiter.version>5.9.3</junit.jupiter.version>
        <mockito.version>5.4.0</mockito.version>
    </properties>

    <dependencies>
        <!--
            Migrated from com.mysql:mysql-connector-j to org.postgresql:postgresql
            for PostgreSQL 16 compatibility.
            Version 42.7.3 supports JDBC 4.2, Java 17+/25, and PostgreSQL 16.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!--
            Spring Boot 3.3.0 – upgraded from 2.7.15.
            Spring Boot 3.x requires Java 17+ and uses the jakarta.* namespace,
            making it fully compatible with Java 25.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <!-- ==================== TEST DEPENDENCIES ==================== -->

        <!-- JUnit 5 Jupiter API – test annotations and assertions -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 Jupiter Engine – test execution engine -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 Jupiter Params – parameterized tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Mockito Core – mocking framework -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Mockito JUnit 5 Extension -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                maven-compiler-plugin 3.13.0 – updated from 3.7.0.
                Uses <release> instead of separate <source>/<target> to enforce
                the correct cross-compilation boundary.
                Change the release value to 25 when JDK 25 is available.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                maven-surefire-plugin 3.2.5 – added explicitly.
                Required for JUnit 5 / Java 17+ test execution.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!--
                spring-boot-maven-plugin – added explicitly.
                Enables 'mvn spring-boot:run' and creates an executable fat-jar.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
