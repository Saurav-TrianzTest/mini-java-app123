<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.3.x parent BOM for Java 25 / Jakarta EE compatibility
         (JAVA11_TO_25_SPRING_BOOT_COMPATIBILITY, JAVA11_TO_25_JAKARTA_EE_MIGRATION) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.test</groupId>
    <artifactId>mini-java-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <!-- Updated from Java 11 to Java 25
             (JAVA11_TO_25_DEPENDENCY_UPDATES, JAVA11_TO_25_MAVEN_PLUGIN_UPDATES) -->
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Spring Boot Web Starter - version managed by parent BOM
             (JAVA11_TO_25_SPRING_BOOT_COMPATIBILITY, JAVA11_TO_25_JAKARTA_EE_MIGRATION) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Updated mysql-connector-java to com.mysql:mysql-connector-j for Java 25 compatibility
             (JAVA11_TO_25_MISSING_DEPENDENCY_VERSIONS, deprecated MySQL GroupId/ArtifactId fix) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>

        <!-- Spring Boot Test - version managed by parent BOM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Updated maven-compiler-plugin from 3.8.1 to 3.13.0 for Java 25 compatibility
                 (JAVA11_TO_25_MAVEN_PLUGIN_UPDATES, JAVA11_TO_25_LOMBOK_CONFIGURATION) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Updated source/target/release from 11 to 25
                         (JAVA11_TO_25_DEPENDENCY_UPDATES) -->
                    <source>25</source>
                    <target>25</target>
                    <release>25</release>
                </configuration>
            </plugin>
            <!-- Added maven-surefire-plugin for Java 25 test compatibility
                 (JAVA11_TO_25_MAVEN_PLUGIN_UPDATES) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
