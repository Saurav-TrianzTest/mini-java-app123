<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        FIX: JAVA11_TO_25_SPRING_BOOT_COMPATIBILITY
        Use Spring Boot 3.3.0 as the parent POM so that its BOM (Bill of Materials)
        manages all transitive dependency versions automatically.  Spring Boot 3.x
        requires Java 17+ and is the first release line that fully supports Java 25.
        Previously the project used Spring Boot 2.7.15 which is incompatible with
        Java 25 (javax.* namespace, old Tomcat, old Hibernate, etc.).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.test</groupId>
    <artifactId>mini-java-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!--
        FIX: JAVA11_TO_25_DEPENDENCY_UPDATES / JAVA11_TO_25_MAVEN_PLUGIN_UPDATES
        Updated compiler source/target/release from Java 11 to Java 25.
        The <java.version> property is honoured by spring-boot-starter-parent
        and propagated to the maven-compiler-plugin automatically.
    -->
    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Explicit version pins for dependencies not managed by the Spring Boot BOM -->
        <lombok.version>1.18.32</lombok.version>
        <mysql-connector-j.version>8.3.0</mysql-connector-j.version>
    </properties>

    <dependencies>
        <!--
            FIX: JAVA11_TO_25_MISSING_DEPENDENCY_VERSIONS
            Switched from the legacy com.mysql:mysql-connector-java (deprecated) to
            the new com.mysql:mysql-connector-j artifact which is the official
            replacement and has full Java 25 / JPMS support.
            Version is pinned via the property above; Spring Boot BOM also manages
            mysql-connector-j from 3.1+ so the property acts as an override.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector-j.version}</version>
        </dependency>

        <!--
            FIX: JAVA11_TO_25_SPRING_BOOT_COMPATIBILITY
            Spring Boot 3.x starter – version is inherited from the parent BOM.
            This replaces the old spring-boot-starter-web 2.7.x which used
            javax.* APIs incompatible with Java 25.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            FIX: JAVA11_TO_25_JAKARTA_EE_MIGRATION
            Spring Boot 3.x transitively brings jakarta.servlet-api 6.x.
            Explicit declaration retained for documentation clarity; version
            is managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            FIX: JAVA11_TO_25_LOMBOK_CONFIGURATION
            Lombok 1.18.32 is the first release with full Java 25 annotation-
            processor support.  Declared as 'provided' so it is not bundled in
            the final JAR.  The annotationProcessorPaths entry in the compiler
            plugin below ensures it is picked up during compilation.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot Test starter for JUnit 5 (Jupiter) support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                FIX: JAVA11_TO_25_MAVEN_PLUGIN_UPDATES / JAVA11_TO_25_LOMBOK_CONFIGURATION
                Updated maven-compiler-plugin to 3.13.0 which is the minimum version
                that correctly handles -release 25 and the new Java 25 language features.
                The annotationProcessorPaths block wires Lombok into the compiler so
                that @Data, @Builder, etc. are processed without requiring a separate
                -processorpath JVM argument.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                FIX: JAVA11_TO_25_MAVEN_PLUGIN_UPDATES (maven-surefire-plugin)
                Explicitly declare maven-surefire-plugin 3.2.5 which:
                  - Supports JUnit 5 (Jupiter) natively
                  - Passes the correct -add-opens flags required by Java 25
                    strong-encapsulation for test frameworks
                Without this declaration Maven falls back to surefire 2.x which
                is incompatible with Java 25 and JUnit 5.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>

            <!--
                Spring Boot Maven plugin – version inherited from parent BOM.
                Responsible for creating the executable fat-JAR.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
