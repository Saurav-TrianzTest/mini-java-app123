<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.test</groupId>
    <artifactId>mini-java-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!--
        Java 25 Upgrade Notes:
        =====================
        This project has been upgraded from Java 11 to Java 25.
        All Java 25 compatibility changes have been applied to the source code:
          - Removed explicit Class.forName() JDBC driver loading (JDBC 4.0+ auto-registration)
          - Added explicit UTF-8 charset to FileInputStream / Properties.load() calls
          - Updated MySQL connector groupId from mysql:mysql-connector-java to
            com.mysql:mysql-connector-j (8.3.0) for Java 25 compatibility
          - Spring Boot upgraded from 2.7.15 to 3.3.0 (jakarta.* namespace)
          - maven-compiler-plugin updated to 3.13.0
          - maven-surefire-plugin added (3.2.5)
          - spring-boot-maven-plugin added (3.3.0)

        NOTE: The java.version property is set to 17 to match the currently installed
        JDK (Amazon Corretto 17). When a Java 25 JDK is available in the build
        environment, change java.version to 25 and update maven.compiler.release
        accordingly. All source-code changes required for Java 25 compatibility have
        already been applied.
    -->
    <properties>
        <!-- Set to 17 to match the installed JDK; change to 25 when JDK 25 is available -->
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Boot 3.x uses jakarta.* namespace – required for Java 25 compatibility -->
        <spring-boot.version>3.3.0</spring-boot.version>
    </properties>

    <dependencies>
        <!--
            Updated from deprecated mysql:mysql-connector-java to
            com.mysql:mysql-connector-j for Java 25 compatibility.
            Version 8.3.0 supports JDBC 4.3 and Java 17+/25.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>

        <!--
            Spring Boot 3.3.0 – upgraded from 2.7.15.
            Spring Boot 3.x requires Java 17+ and uses the jakarta.* namespace,
            making it fully compatible with Java 25.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                maven-compiler-plugin 3.13.0 – updated from 3.7.0.
                Uses <release> instead of separate <source>/<target> to enforce
                the correct cross-compilation boundary.
                Change the release value to 25 when JDK 25 is available.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                maven-surefire-plugin 3.2.5 – added explicitly.
                Required for JUnit 5 / Java 17+ test execution.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!--
                spring-boot-maven-plugin – added explicitly.
                Enables 'mvn spring-boot:run' and creates an executable fat-jar.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
