<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.test</groupId>
    <artifactId>mini-java-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <!-- Java 25 upgrade: source/target updated from 11 to 17.
             Java 25 is the target runtime; the build environment provides Java 17
             (the latest LTS available in this CI environment). All Java 25
             compatibility changes (JEP 400 UTF-8 default, JDBC 4.0 auto-loading,
             Spring Boot 3.x / Jakarta EE namespace) have already been applied to
             the source code. When a Java 25 JDK becomes available in the build
             environment, change these values to 25. -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Updated from deprecated mysql:mysql-connector-java (groupId mysql)
             to the new com.mysql:mysql-connector-j artifact for Java 17/25
             compatibility. Version 9.1.0 supports Java 17+ and JDBC 4.3. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.1.0</version>
        </dependency>

        <!-- Updated Spring Boot from 2.7.0 (javax.* / Java 11) to 3.4.1
             (jakarta.* / Java 17+) for full Java 25 compatibility.
             Spring Boot 3.x requires Java 17 as the minimum runtime. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>3.4.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Updated maven-compiler-plugin from 3.8.1 to 3.13.0.
                 Version 3.8.1 does not support release 17/25; 3.13.0 does.
                 The release tag is preferred over source/target because it
                 also enforces the correct bootstrap classpath. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- Explicitly declare maven-surefire-plugin 3.5.2.
                 The default version bundled with Maven 3.8.x is too old to run
                 JUnit 5 tests on Java 17/25 without additional configuration. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
